<?xml version="1.0"?>
<sdf version="1.6">
  <world name="road_world">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ================= Asphalt (visual only) ================= -->
    <model name="road_asphalt_a">
      <static>true</static>
      <pose>5.0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>11 2.2 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="road_asphalt_b">
      <static>true</static>
      <pose>10 5.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>2.2 11 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Center line (visual only) ================= -->
    <model name="road_centerline_a">
      <static>true</static>
      <pose>4.75 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>10.5 0.05 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="road_centerline_b">
      <static>true</static>
      <pose>10 5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.05 10 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Barriers =================
         Straight A: centerline x:[0,10] y=0, width 2.2 (half 1.1)
         90° left turn at (10, 0)
         Straight B: centerline x=10 y:[0,10], width 2.2 (half 1.1)
         Outer (convex) corner at (11.1,-1.1); inner (concave) corner at (8.9,1.1)
    -->
    <model name="barrier_outer_a">
      <static>true</static>
      <pose>5.6 -1.15 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>11.2 0.1 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>11.2 0.1 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.05 1</ambient>
            <diffuse>0.9 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="barrier_outer_b">
      <static>true</static>
      <pose>11.15 5.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 12.4 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 12.4 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.05 1</ambient>
            <diffuse>0.9 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="barrier_inner_a">
      <static>true</static>
      <pose>4.45 1.15 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8.9 0.1 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8.9 0.1 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.05 1</ambient>
            <diffuse>0.9 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="barrier_inner_b">
      <static>true</static>
      <pose>8.85 5.55 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 8.9 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 8.9 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.05 1</ambient>
            <diffuse>0.9 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
